# Do not commit actual secrets. Generate a random token, for example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
STANDALONE_API_TOKEN=
# Optional: only if the model is not already available in ./model-source/
# Hugging Face repo must be a trusted org/repo; manifest sourceRevision is a full commit.
STANDALONE_HF_REPO=
# Optional: private RustFS/S3 model mirror and MP3 output.
STANDALONE_MODEL_S3_BUCKET=
STANDALONE_MODEL_S3_PREFIX=
STANDALONE_OUTPUT_S3_BUCKET=
STANDALONE_OUTPUT_S3_PREFIX=
# Example: https://rustfs.internal.example:9000; use HTTPS outside loopback.
STANDALONE_S3_ENDPOINT_URL=
STANDALONE_S3_REGION=
