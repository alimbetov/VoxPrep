<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <!-- v1 compatible contract: one body contains explicitly enumerated
       type-specific fields, validated against content type by Java. -->
  <xs:element name="voxprep">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="content" minOccurs="1" maxOccurs="100">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="title" type="xs:string"/>
              <xs:element name="subtitle" type="xs:string"/>
              <xs:element name="description" type="xs:string"/>
              <xs:element name="categoryCode" type="xs:string"/>
              <xs:element name="levelCode" type="xs:string"/>
              <xs:element name="minutes" type="xs:positiveInteger"/>
              <xs:element name="availability">
                <xs:simpleType><xs:restriction base="xs:string">
                  <xs:enumeration value="ACTIVE"/><xs:enumeration value="INACTIVE"/>
                </xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="skill" type="xs:string" minOccurs="1" maxOccurs="20"/>
              <xs:element name="body">
                <xs:complexType>
                  <xs:choice minOccurs="1" maxOccurs="100">
              <xs:element name="phrase" type="xs:string"/>
              <xs:element name="usage" type="xs:string"/>
              <xs:element name="example" type="xs:string"/>
              <xs:element name="term" type="xs:string"/>
              <xs:element name="definition" type="xs:string"/>
              <xs:element name="partOfSpeech" type="xs:string"/>
              <xs:element name="prompt" type="xs:string"/>
              <xs:element name="modelAnswer" type="xs:string"/>
              <xs:element name="keyPoint" type="xs:string"/>
              <xs:element name="transcript" type="xs:string"/>
              <xs:element name="questionText" type="xs:string"/>
              <xs:element name="explanation" type="xs:string"/>
              <xs:element name="instructions" type="xs:string"/>
              <xs:element name="questionRevisionId" type="xs:string"/>
                    <xs:element name="passingScorePercent">
                      <xs:simpleType><xs:restriction base="xs:integer">
                        <xs:minInclusive value="0"/><xs:maxInclusive value="100"/>
                      </xs:restriction></xs:simpleType>
                    </xs:element>
                    <xs:element name="section">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="heading" type="xs:string"/>
                          <xs:element name="text" type="xs:string"/>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="segment">
                      <xs:complexType>
                        <xs:simpleContent><xs:extension base="xs:string">
                          <xs:attribute name="startMs" type="xs:nonNegativeInteger" use="required"/>
                          <xs:attribute name="endMs" type="xs:positiveInteger" use="required"/>
                        </xs:extension></xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="option">
                      <xs:complexType>
                        <xs:simpleContent><xs:extension base="xs:string">
                          <xs:attribute name="key" type="xs:string" use="required"/>
                          <xs:attribute name="correct" type="xs:boolean" use="required"/>
                        </xs:extension></xs:simpleContent>
                      </xs:complexType>
                    </xs:element>
                  </xs:choice>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="code" type="xs:string" use="required"/>
            <xs:attribute name="type" use="required">
              <xs:simpleType><xs:restriction base="xs:string">
                <xs:enumeration value="phrase"/>
                <xs:enumeration value="vocabulary"/>
                <xs:enumeration value="interview"/>
                <xs:enumeration value="topic"/>
                <xs:enumeration value="shadowing"/>
                <xs:enumeration value="question"/>
                <xs:enumeration value="practice_test"/>
              </xs:restriction></xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="schemaVersion" use="required" fixed="1" type="xs:string"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
