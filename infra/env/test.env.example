COMPOSE_PROJECT_NAME=voxprep-test
POSTGRES_IMAGE=postgres:18.6-bookworm
POSTGRES_DB=voxprep_test
POSTGRES_USER=voxprep_bootstrap
POSTGRES_VOLUME_NAME=voxprep_test_pgdata
RUSTFS_IMAGE=rustfs/rustfs:1.0.4
RUSTFS_RC_IMAGE=rustfs/rc:v0.1.30
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=voxprep-assets
RUSTFS_POLICY_NAME=voxprep-backend-rw
RUSTFS_DATA_VOLUME_NAME=voxprep_test_rustfs_data
RUSTFS_LOG_VOLUME_NAME=voxprep_test_rustfs_logs
BACKEND_NETWORK_NAME=voxprep-test-backend-private
