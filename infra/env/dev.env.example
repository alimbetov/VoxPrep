COMPOSE_PROJECT_NAME=voxprep-dev
POSTGRES_IMAGE=postgres:18.6-bookworm
POSTGRES_DB=voxprep_dev
POSTGRES_USER=voxprep_bootstrap
POSTGRES_HOST_PORT=5432
POSTGRES_VOLUME_NAME=voxprep_dev_pgdata
RUSTFS_IMAGE=rustfs/rustfs:1.0.4
RUSTFS_RC_IMAGE=rustfs/rc:v0.1.30
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=voxprep-assets
RUSTFS_POLICY_NAME=voxprep-backend-rw
RUSTFS_API_HOST_PORT=9000
RUSTFS_CONSOLE_HOST_PORT=9001
RUSTFS_DATA_VOLUME_NAME=voxprep_dev_rustfs_data
RUSTFS_LOG_VOLUME_NAME=voxprep_dev_rustfs_logs
BACKEND_NETWORK_NAME=voxprep-dev-backend-private
