  "fixed_sql": [
    {
      "name": "app_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_preferences\" (\"id\" INTEGER NOT NULL, \"ui_locale\" TEXT NOT NULL, \"translation_locale\" TEXT NOT NULL, \"preferred_accent\" TEXT NULL, \"theme_code\" TEXT NOT NULL, \"focus_mode\" INTEGER NOT NULL DEFAULT 0 CHECK (\"focus_mode\" IN (0, 1)), \"storage_quota_bytes\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "installation_runtime_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"installation_runtime_states\" (\"id\" INTEGER NOT NULL, \"registration_state\" TEXT NOT NULL, \"last_registration_at\" INTEGER NULL, \"last_token_refresh_at\" INTEGER NULL, \"last_success_at\" INTEGER NULL, \"last_error_code\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "content_manifest_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"content_manifest_states\" (\"id\" INTEGER NOT NULL, \"schema_version\" INTEGER NOT NULL, \"current_content_version\" INTEGER NOT NULL, \"current_manifest_checksum\" TEXT NOT NULL, \"remote_content_version_seen\" INTEGER NULL, \"remote_manifest_checksum\" TEXT NULL, \"etag\" TEXT NULL, \"last_checked_at\" INTEGER NULL, \"last_successful_sync_at\" INTEGER NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "content_pack_revisions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"content_pack_revisions\" (\"pack_code\" TEXT NOT NULL, \"variant_key\" TEXT NOT NULL, \"revision\" INTEGER NOT NULL, \"schema_version\" INTEGER NOT NULL, \"checksum\" TEXT NOT NULL, \"state\" TEXT NOT NULL, \"source_content_version\" INTEGER NOT NULL, \"staged_at\" INTEGER NOT NULL, \"verified_at\" INTEGER NULL, \"current_at\" INTEGER NULL, \"superseded_at\" INTEGER NULL, PRIMARY KEY (\"pack_code\", \"variant_key\", \"revision\"));"
        }
      ]
    },
    {
      "name": "local_content_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_content_records\" (\"content_code\" TEXT NOT NULL, \"content_type\" TEXT NOT NULL, \"revision\" INTEGER NOT NULL, \"checksum\" TEXT NOT NULL, \"sort_order\" INTEGER NULL, \"published_at\" INTEGER NULL, \"snapshot_state\" TEXT NOT NULL, \"source_schema_version\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"content_code\", \"content_type\", \"revision\"));"
        }
      ]
    },
    {
      "name": "favorites",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"favorites\" (\"content_code\" TEXT NOT NULL, \"content_type\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"content_code\", \"content_type\"));"
        }
      ]
    },
    {
      "name": "content_learning_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"content_learning_states\" (\"content_code\" TEXT NOT NULL, \"content_type\" TEXT NOT NULL, \"listened_at\" INTEGER NULL, \"listen_count\" INTEGER NOT NULL DEFAULT 0, \"last_played_at\" INTEGER NULL, \"last_position_ms\" INTEGER NULL, \"completed_at\" INTEGER NULL, \"completion_source\" TEXT NULL, \"last_revision_seen\" INTEGER NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"content_code\", \"content_type\"));"
        }
      ]
    }
